local debug = false
local function print_log(message) if debug then cecho("<yellow>" .. message .. "\n") end end

function calendar.get_prefix(type)
  local arr = string.split(type, "_")
  local domain = arr[#arr]
  if domain == "imperial" then return "<aquamarine>[<light_goldenrod>Imperium<aquamarine>]<reset> "
  elseif domain == "ishtar" then return "<aquamarine>[<cornflower_blue>Ishtar<aquamarine>]<reset> " end
  return ""
end

function calendar.check_filters(filters)
  if not filters or #filters == 0 then return false end
  local first_prefix = calendar.get_prefix(filters[1])
  if first_prefix == "" then return true end
  for i = 2, #filters do
    if first_prefix ~= calendar.get_prefix(filters[i]) then return false end
  end
  return true
end

function calendar.create_calendar(cal, offset)
  local timestamp = offset
  local type = ""
  if offset == nil then print_log("Błąd w narzutu kalendarza: "..cal.config.name.." -> "..offset); return cal end
  if offset == 0 then type = "template"
  elseif offset > 0 then type = "calendar" end
  
  if string.len(type) > 0 then
    cal.data[type] = {}
    for i=1,tonumber(cal.config.days_in_year) do
      cal.data[type][i] = {}
      for j=0,23 do
        cal.data[type][i][j] = timestamp
        timestamp = timestamp + calendar.gamehour_real_time
      end
    end
    if offset > 0 then
   
       cal.data.offset = offset
      cal = calendar.reload_calendar(cal)
    end
  else
    print_log("Błąd w narzutu kalendarza: "..cal.config.name.." -> "..offset)
  end
  return cal
end

function calendar.refresh_calendar(cal, d, h)
  cal.data.offset = getEpoch() - cal.data.template[d][h]
  cal = calendar.create_calendar(cal, cal.data.offset)
  calendar.domain = cal.config.domain
  calendar.save_local_time_data(cal)
  return calendar.reload_calendar(cal)
end

function calendar.reload_calendar(cal)
  local function fill_time(a, b, add)
    if a >= b then return a end
    return a + (math.ceil((b - a) / add) * add)
  end
  if cal and cal.data and cal.data.calendar and table_size(cal.data.calendar) > 0 then
    cal.data.results = {}
    local t = 0
    local et = getEpoch()
    for _, v in pairs(cal.config.search_times) do
      local day = tonumber(v.day)
      if cal.data.calendar[day] and cal.data.calendar[day][v.hour] then
        t = cal.data.calendar[day][v.hour]
        if t < et then t = fill_time(t, et, cal.config.year_time) end
        if not cal.data.results[t] then
          cal.data.results[t] = { desc = v.desc, timestamp = t, color = v.color, type = v.type, precision = cal.data.precision, game_date = "("..calendar.get_gamedate(cal, day, v.hour)..")"}
        end
      end
    end
    local results_list = {}
    for _, event in pairs(cal.data.results) do table.insert(results_list, event) end
    cal.data.results = results_list
  else
    print_log("Błąd w przeladowaniu kalendarza: ".. (cal.config and cal.config.name or "Nieznany"))
  end
  return cal
end

function calendar.get_events_results()
  if calendar.imperial and calendar.imperial.data and table_size(calendar.imperial.data.calendar or {}) > 0 then calendar.imperial = calendar.reload_calendar(calendar.imperial) end
  if calendar.ishtar and calendar.ishtar.data and table_size(calendar.ishtar.data.calendar or {}) > 0 then calendar.ishtar = calendar.reload_calendar(calendar.ishtar) end
  
  local union = {}
  local imp_res = calendar.imperial and calendar.imperial.data and calendar.imperial.data.results
  local ish_res = calendar.ishtar and calendar.ishtar.data and calendar.ishtar.data.results

  if imp_res and #imp_res > 0 and ish_res and #ish_res > 0 then
    union = table_n_union(imp_res, ish_res)
  elseif imp_res and #imp_res > 0 then union = imp_res
  elseif ish_res and #ish_res > 0 then union = ish_res end

  table.sort(union, function(a, b) return a["timestamp"] < b["timestamp"] end)
  return union
end

function calendar.resttime(time)
 
   if time <= 0 then return "0s" end
  local days = math.floor(time/86400);
  local rem = time % 86400
  local hours = math.floor(rem/3600);
  rem = rem % 3600
  local minutes = math.floor(rem/60);
  local seconds = math.floor(rem % 60)
  if days > 0 then return days.."d "..hours.."h"
  elseif hours > 0 then return hours.."h "..minutes.."m"
  else return minutes.."m "..seconds.."s" end
end

function calendar.format_12h(hour, with_suffix)
    local h12 = hour % 12
    if h12 == 0 then h12 = 12 end
    local suffix = hour < 12 and "am" or "pm"
    local color = suffix == "am" and "light_yellow" or "light_grey"
    if with_suffix then
        return string.format("<%s>%d%s<reset>", color, h12, suffix)
    
    else
        return string.format("<%s>%d:00<reset>", color, h12)
    end
end

function calendar.show_calendar_results(filters, in_real_days)
  local now = getEpoch()
  local time_limit = (in_real_days or 0) * 86400
  local desc_type = calendar.check_filters(filters)
  
  local union = calendar.get_events_results()
  for _, v in pairs(union) do
    if filters == nil or table_contains(filters, v["type"]) then
      local t = v["timestamp"] - now
      local output_line
      local event_desc = v.desc .. string.rep(" ", 20 - #v.desc)
      
      
      if desc_type then
        output_line = string.format("<%s>%s <yellow>-> <wheat>za %-10s <gray>(%s)\n", v["color"], event_desc, calendar.resttime(t), os.date('%H:%M %d.%m', v["timestamp"]))
      else
        output_line = string.format("%s<%s>%s <yellow>-> <wheat>za %-10s <gray>(%s)\n", calendar.get_prefix(v["type"]), v["color"], event_desc, calendar.resttime(t), os.date('%H:%M %d.%m', v["timestamp"]))
      end

      if time_limit > 0 then
        if t >= 0 and t <= time_limit then cecho(output_line) end
      else
     
         if t >=0 then cecho(output_line) end
      end
    end
  end
end

function calendar.save_local_time_data()
  local data = { 
    imperial_offset = calendar.imperial.data.offset, 
    ishtar_offset = calendar.ishtar.data.offset,
    observed_sun_times = calendar.observed_sun_times
  }
  local path = calendar.json_file_path
  local file, err = io.open(path, "w")
  if file then file:write(yajl.to_string(data));
  file:close()
  else print_log("Nie udalo sie zapisac pliku JSON: " .. tostring(err)) end
end

function calendar.read_local_time_data()
  if io.exists(calendar.json_file_path) then
    local file, err = io.open(calendar.json_file_path, "r")
    if not file then print_log("Nie udalo sie odczytac pliku JSON: " .. tostring(err));
    return end
    local content = file:read("*a"); file:close()
    local data = yajl.to_value(content)
    if data and data["imperial_offset"] and tonumber(data["imperial_offset"]) > 0 then
      calendar.imperial = calendar.create_calendar(calendar.imperial, data["imperial_offset"])
    end
    if data and data["ishtar_offset"] and tonumber(data["ishtar_offset"]) > 0 then
      calendar.ishtar = calendar.create_calendar(calendar.ishtar, data["ishtar_offset"])
    end
    if data and data["observed_sun_times"] then
      calendar.observed_sun_times = data["observed_sun_times"]
    end
  end
end

function calendar.init()
  for _, cal in pairs({calendar.imperial, calendar.ishtar}) do
   
       if cal.config.seasons then
          table.sort(cal.config.seasons, function(a, b) return a.day < b.day end)
      end
      cal.config.sorted_months = {}
      if cal.config.first_day_of_calparts then
          for name, start_day in pairs(cal.config.first_day_of_calparts) do
            table.insert(cal.config.sorted_months, {name = name, start = start_day})
          end
          table.sort(cal.config.sorted_months, function(a,b) return a.start < b.start end)
      end
  end

  calendar.imperial = calendar.create_calendar(calendar.imperial, 0)
  calendar.ishtar = calendar.create_calendar(calendar.ishtar, 0)
  calendar.read_local_time_data()
  calendar.init_gmcp()
end

function calendar.init_gmcp()
  event_handlers = event_handlers or {}
  if event_handlers["calendar_time"] then killAnonymousEventHandler(event_handlers["calendar_time"]) end
  event_handlers["calendar_time"] = registerAnonymousEventHandler("gmcp.room.time", calendar.handle_gmcp_time)
  if event_handlers["calendar_domain"] then killAnonymousEventHandler(event_handlers["calendar_domain"]) end
  event_handlers["calendar_domain"] = registerAnonymousEventHandler("gmcp.room.info.map", calendar.handle_gmcp_domain)
end

function calendar.handle_gmcp_time()
  if gmcp.room.time.daylight ~= calendar.last_daylight_status and calendar.last_daylight_status ~= nil then
      local cal_name = calendar.domain
      local event_type = gmcp.room.time.daylight and "sunrise" or "sunset"
      cecho(string.format("\n<cornflower_blue>INFO: <white>Wykryto %s, synchronizowanie kalendarza...", event_type))
  
      calendar.recalibrate_by_event(cal_name, event_type)
  end
  calendar.last_daylight_status = gmcp.room.time.daylight
end

function calendar.handle_gmcp_domain()
  if gmcp and gmcp.room and gmcp.room.info and gmcp.room.info.map and gmcp.room.info.map.domain then
    if gmcp.room.info.map.domain == "Imperium" then calendar.domain = "imperial"
    elseif gmcp.room.info.map.domain == "Ishtar" then calendar.domain = "ishtar" end
  end
end

function calendar.get_monthday(cal, day)
  local cache_key = cal.config.domain .. "_monthday_" .. tostring(day)
  if calendar.cache[cache_key] then return calendar.cache[cache_key] end
  
  if not cal.config.sorted_months then return {day=0, month="błąd"} end
  
  local sorted_months = cal.config.sorted_months
  local month_info = {day=0, month="nieznany"}
  for i = #sorted_months, 1, -1 do
 
       if day >= sorted_months[i].start then
      month_info = {day = day - sorted_months[i].start + 1, month = sorted_months[i].name}
      break
    end
  end
  calendar.cache[cache_key] = month_info
  return month_info
end

function calendar.get_gamedate(cal, ds, h)
  local dd = calendar.get_monthday(cal, tonumber(ds))
  return dd.day .. ". " .. dd.month .. " o " .. calendar.format_12h(tonumber(h), false) .. " [" .. ds .. "]"
end

function calendar.strip_colors(str)
    if not str then return "" end
    return str:gsub("<[^>]+>", "")
end

function table_contains(t, val)
  for _, v in pairs(t) do if v == val then return true end end
  return false
end

function table_size(t)
  local count = 0
  for _ in pairs(t) do count = count + 1 end
  return count
end

function table_n_union(t1, t2)
  local res = {}
  for _, v in ipairs(t1) do table.insert(res, v) end
  for _, v in ipairs(t2) do 
  table.insert(res, v) end
  return res
end

function calendar.get_current_season(cal, day)
    local current_season = "Nieznana"
    if not cal.config.seasons then return current_season end
    for _, season in ipairs(cal.config.seasons) do
        if tonumber(day) >= tonumber(season.day) then current_season = season.name else break end
    end
    return current_season
end

function calendar.get_month_info(cal, day)
    local cache_key = cal.config.domain .. "_monthinfo_" .. tostring(day)
    if calendar.cache[cache_key] then return calendar.cache[cache_key] end

    if not cal.config.sorted_months then return {name = "Błąd", day = 0, length = 0} 
 end
    local sorted_months = cal.config.sorted_months
    local current_month = {name = "Unknown", day = 0, length = 0}
    for i = #sorted_months, 1, -1 do
        local month = sorted_months[i]
        if day >= month.start then
            current_month.name = month.name
            current_month.day = day - month.start + 1
            if i < #sorted_months then current_month.length = sorted_months[i+1].start - month.start
            else current_month.length = cal.config.days_in_year - month.start + 1 end
            break
        end
    end
    calendar.cache[cache_key] = current_month
    return current_month
end

function calendar.time_to_minutes(time_str)
    if not time_str then return 0 end
    local h, m = time_str:match("(%d+):(%d+)")
    return (tonumber(h) or 0) * 60 + (tonumber(m) or 0)
end

function calendar.minutes_to_time(minutes)
    local h = math.floor(minutes / 60) % 24
   
     local m = math.floor(minutes % 60)
    return string.format("%02d:%02d", h, m)
end

function calendar.get_sunrise_sunset(cal, day)
    -- Pobierz zaobserwowane dane, jeśli istnieją
    local observed = calendar.observed_sun_times[cal.config.domain] and calendar.observed_sun_times[cal.config.domain][tostring(day)]

    -- Jeśli mamy obie zaobserwowane wartości, możemy je zwrócić od razu
    if observed and observed.sunrise and observed.sunset then
        return observed
    end

    -- Fallback do interpolacji, jeśli nie ma pełnych danych zaobserwowanych
    -- Użyj cache tylko wtedy, gdy nie ma żadnych nowych danych zaobserwowanych
    local cache_key = cal.config.domain .. "_sun_" .. tostring(day)
    if calendar.cache[cache_key] and not observed then
        return calendar.cache[cache_key]
    end

    local cycle = cal.config.sun_cycle
    table.sort(cycle, function(a,b) return a.day < b.day end)
    
    local p1, p2
    if day < cycle[1].day then
        p1, p2 = cycle[#cycle], cycle[1]
    else
        for i = 1, #cycle do
            if day >= cycle[i].day then
                p1 = cycle[i]
                p2 = (i == #cycle) and cycle[1] or cycle[i+1]
            else
                break
            end
        end
    end

    if not p1 or not p2 then
        -- Zwróć domyślne wartości, jeśli coś pójdzie nie tak
        return { sunrise = "06:00", sunset = "18:00" }
    end

    local total_days = (p2.day < p1.day) and (cal.config.days_in_year - p1.day) + p2.day or p2.day - p1.day
    
    local result
    if total_days == 0 then
        result = { sunrise = p1.sunrise, sunset = p1.sunset }
    else
        local days_into = (day < p1.day) and (cal.config.days_in_year - p1.day) + day or day - p1.day
        local progress = days_into / total_days
        
        local sunrise1, sunset1 = calendar.time_to_minutes(p1.sunrise), calendar.time_to_minutes(p1.sunset)
        local sunrise2, sunset2 = calendar.time_to_minutes(p2.sunrise), calendar.time_to_minutes(p2.sunset)

        local current_sunrise = calendar.minutes_to_time(sunrise1 + (sunrise2 - sunrise1) * progress)
        local current_sunset = calendar.minutes_to_time(sunset1 + (sunset2 - sunset1) * progress)
        
        result = { sunrise = current_sunrise, sunset = current_sunset }
    end
    
    -- Połącz wynik interpolacji z zaobserwowanymi danymi
    if observed then
        if observed.sunrise then result.sunrise = observed.sunrise end
        if observed.sunset then result.sunset = observed.sunset end
    end
    
    -- Zapisz w cache i zwróć pełny wynik
    calendar.cache[cache_key] = result
    return result
end

function calendar.get_next_sun_event_timestamp(cal, day)
    local now_ts = getEpoch()
    
    local sun_times_today = calendar.get_sunrise_sunset(cal, day)
    local sunrise_today_min = calendar.time_to_minutes(sun_times_today.sunrise)
    local sunset_today_min = calendar.time_to_minutes(sun_times_today.sunset)
    
   
     local day_start_ts = cal.data.calendar[day][0]
    local sunrise_today_ts = day_start_ts + (sunrise_today_min * (calendar.gamehour_real_time / 60))
    local sunset_today_ts = day_start_ts + (sunset_today_min * (calendar.gamehour_real_time / 60))

    local next_sunrise_ts, next_sunset_ts

    if now_ts < sunrise_today_ts then
        next_sunrise_ts = sunrise_today_ts
    else
        local next_day = (day % cal.config.days_in_year) + 1
        local sun_times_tomorrow = calendar.get_sunrise_sunset(cal, next_day)
        local sunrise_tomorrow_min = calendar.time_to_minutes(sun_times_tomorrow.sunrise)
    
         local next_day_start_ts = cal.data.calendar[next_day][0]
        next_sunrise_ts = next_day_start_ts + (sunrise_tomorrow_min * (calendar.gamehour_real_time / 60))
    end

    if now_ts < sunset_today_ts then
        next_sunset_ts = sunset_today_ts
    else
        local next_day = (day % cal.config.days_in_year) + 1
        local sun_times_tomorrow = calendar.get_sunrise_sunset(cal, next_day)
        local sunset_tomorrow_min = calendar.time_to_minutes(sun_times_tomorrow.sunset)
        local next_day_start_ts = cal.data.calendar[next_day][0]
  
        next_sunset_ts = next_day_start_ts + (sunset_tomorrow_min * (calendar.gamehour_real_time / 60))
    end
    
    return { sunrise_ts = next_sunrise_ts, sunset_ts = next_sunset_ts }
end

function calendar.display_full_time_info(cal, day, hour)
    if not day or not cal or not cal.data.calendar or not cal.data.calendar[day] then return end

    local now_ts = getEpoch()
    local day_num = tonumber(day)
    local next_day_num = (day_num % cal.config.days_in_year) + 1

    -- Zabezpieczenie na wypadek braku danych dla następnego dnia
    if not cal.data.calendar[next_day_num] then
        print_log("Błąd krytyczny: brak danych dla następnego dnia w kalendarzu. Spróbuj zresetować skrypt.")
        return
    end

    -- Pobierz czasy wschodu/zachodu ("HH:MM") dla dzisiaj i jutra
    local sun_today = calendar.get_sunrise_sunset(cal, day_num)
    local sun_tomorrow = calendar.get_sunrise_sunset(cal, next_day_num)

    -- Konwertuj czasy na minuty od początku doby
    local sunrise_today_min = calendar.time_to_minutes(sun_today.sunrise)
    local sunset_today_min = calendar.time_to_minutes(sun_today.sunset)
    local sunrise_tomorrow_min = calendar.time_to_minutes(sun_tomorrow.sunrise)
    local sunset_tomorrow_min = calendar.time_to_minutes(sun_tomorrow.sunset)

    -- Pobierz timestampy początku dnia (00:00) dla dzisiaj i jutra
    local day_start_ts = cal.data.calendar[day_num][0]
    local next_day_start_ts = cal.data.calendar[next_day_num][0]

    -- Oblicz dokładne, bezwzględne timestampy dla każdego wydarzenia
    local sec_per_game_min = calendar.gamehour_real_time / 60
    local sunrise_today_ts = day_start_ts + (sunrise_today_min * sec_per_game_min)
    local sunset_today_ts = day_start_ts + (sunset_today_min * sec_per_game_min)
    local sunrise_tomorrow_ts = next_day_start_ts + (sunrise_tomorrow_min * sec_per_game_min)
    local sunset_tomorrow_ts = next_day_start_ts + (sunset_tomorrow_min * sec_per_game_min)

    -- Ustal, które wydarzenia (dzisiejsze czy jutrzejsze) są następne w kolejności
    local next_sunrise_ts, next_sunset_ts

    if now_ts < sunrise_today_ts then
        -- Scenariusz 1: Przed dzisiejszym wschodem słońca
        next_sunrise_ts = sunrise_today_ts
        next_sunset_ts = sunset_today_ts
    elseif now_ts >= sunrise_today_ts and now_ts < sunset_today_ts then
        -- Scenariusz 2: Po dzisiejszym wschodzie, ale przed zachodem (w ciągu dnia)
        next_sunrise_ts = sunrise_tomorrow_ts
        next_sunset_ts = sunset_today_ts
    else
        -- Scenariusz 3: Po dzisiejszym zachodzie słońca (w nocy)
        next_sunrise_ts = sunrise_tomorrow_ts
        next_sunset_ts = sunset_tomorrow_ts
    end

    local time_to_sunrise = next_sunrise_ts - now_ts
    local time_to_sunset = next_sunset_ts - now_ts

    -- === Reszta funkcji formatującej (bez zmian) ===
    local season = calendar.get_current_season(cal, day_num)
    local month_info = calendar.get_month_info(cal, day_num)
    local next_events = calendar.get_next_n_events(3)
    
    local line_sep = "<slate_grey>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━<reset>"
    local title = string.format("           <white>..:: %s ::..", cal.config.name)
    local subtitle = string.format("          <dim_grey>(%s. %s, dzien %d/%d)<reset>", month_info.day, month_info.name, day_num, cal.config.days_in_year)
    
    local line1_part1 = string.format("<light_steel_blue>Godzina: <white>%s", calendar.format_12h(hour, false))
    local line1_part2 = string.format("<light_steel_blue>Pora Roku: <white>%s", season)
    local line1_padding = 35 - #calendar.strip_colors(line1_part1)
    if line1_padding < 1 then line1_padding = 1 end
    local line1 = line1_part1 .. string.rep(" ", line1_padding) .. line1_part2

    local line2_part1 = string.format("<gold>Nastepny swit: <white>%s", os.date("%H:%M", next_sunrise_ts) .. " (za " .. calendar.resttime(time_to_sunrise) .. ")")
    local line2_part2 = string.format("<gold>Nastepny zmierzch: <white>%s", os.date("%H:%M", next_sunset_ts) .. " (za " .. calendar.resttime(time_to_sunset) .. ")")
    local line2_padding = 35 - #calendar.strip_colors(line2_part1)
    if line2_padding < 1 then line2_padding = 1 end
    local line2 = line2_part1 .. string.rep(" ", line2_padding) .. line2_part2

    local events_string = ""
    if #next_events > 0 then
        local events_list = {}
        for _, event in ipairs(next_events) do
            local remaining_time = event.timestamp - getEpoch()
            if remaining_time > 0 then
                local event_desc = event.desc .. string.rep(" ", 20 - #event.desc)
                table.insert(events_list, string.format("  %s<%s>%s <yellow>-> <wheat>za %-10s <gray>(%s)", 
                     calendar.get_prefix(event.type), event.color, event_desc, 
                    calendar.resttime(remaining_time), os.date('%H:%M %d.%m', event.timestamp)))
            end
        end
        events_string = table.concat(events_list, "\n")
    else
        events_string = "  <dim_gray>Brak nadchodzących wydarzeń do wyświetlenia."
    end

    cecho("\n" .. line_sep .. "\n" .. title .. "\n" .. subtitle .. "\n" .. line_sep .. "\n" .. line1 .. "\n" .. line2 .. "\n" .. line_sep .. "\n" .. "<light_steel_blue>NADCHODZACE WYDARZENIA:\n<reset>" .. events_string .. "\n" .. line_sep .. "\n")
end

function calendar.get_next_n_events(n, filters)
    local now = getEpoch()
  
     local union = calendar.get_events_results()
    local next_events = {}
    for _, event in ipairs(union) do
        if (filters == nil or table_contains(filters, event.type)) and event.timestamp >= now then
            table.insert(next_events, event)
            if #next_events == n then break end
        end
    end
    return next_events
end

function calendar.recalibrate_by_event(cal_name, event_type)
	if not cal_name or not calendar[cal_name] or not calendar[cal_name].data.offset or calendar[cal_name].data.offset == 0 then return end
	local cal = calendar[cal_name]
	local now = getEpoch()
	local seconds_in_game_day = 24 * calendar.gamehour_real_time
	local elapsed_time_in_year = (now - cal.data.offset) % cal.config.year_time
	local current_game_day = math.floor(elapsed_time_in_year / seconds_in_game_day) + 1
	if not current_game_day then return end

	local sun_times = calendar.get_sunrise_sunset(cal, current_game_day)
	local event_time_str = (event_type == "sunrise") and sun_times.sunrise or sun_times.sunset
	if not event_time_str then return end

	local event_minutes = calendar.time_to_minutes(event_time_str)
	local event_seconds_into_day = event_minutes * (calendar.gamehour_real_time / 60)
	local day_start_timestamp_template = cal.data.template[current_game_day][0]
	local new_offset = now - (day_start_timestamp_template + event_seconds_into_day)

	cal.data.offset = new_offset
	calendar[cal_name] = calendar.create_calendar(cal, new_offset)
    
    -- Zapisz zaobserwowany czas
    if not calendar.observed_sun_times[cal.config.domain] then calendar.observed_sun_times[cal.config.domain] = {} 
 end
    if not calendar.observed_sun_times[cal.config.domain][tostring(current_game_day)] then calendar.observed_sun_times[cal.config.domain][tostring(current_game_day)] = {} end
    calendar.observed_sun_times[cal.config.domain][tostring(current_game_day)][event_type] = event_time_str
    
	cecho(string.format("\n<light_steel_blue>Kalendarz (%s) został automatycznie zsynchronizowany.<reset>", cal.config.name))
end

calendar.init()

