	<TriggerPackage>
		<TriggerGroup isActive="yes" isFolder="yes" isTempTrigger="no" isMultiline="no" isPerlSlashGOption="no" isColorizerTrigger="no" isFilterTrigger="no" isSoundTrigger="no" isColorTrigger="no" isColorTriggerFg="no" isColorTriggerBg="no">
			<name>Kalendarz 2.0</name>
			<script></script>
			<triggerType>0</triggerType>
			<conditonLineDelta>0</conditonLineDelta>
			<mStayOpen>0</mStayOpen>
			<mCommand></mCommand>
			<packageName>Kalendarz 2.0</packageName>
			<mFgColor>#ff0000</mFgColor>
			<mBgColor>#ffff00</mBgColor>
			<mSoundFile></mSoundFile>
			<colorTriggerFgColor>#000000</colorTriggerFgColor>
			<colorTriggerBgColor>#000000</colorTriggerBgColor>
			<regexCodeList />
			<regexCodePropertyList />
			<Trigger isActive="yes" isFolder="no" isTempTrigger="no" isMultiline="no" isPerlSlashGOption="no" isColorizerTrigger="no" isFilterTrigger="no" isSoundTrigger="no" isColorTrigger="no" isColorTriggerFg="no" isColorTriggerBg="no">
				<name>kalendarz ishtar</name>
				<script>local yd = 0
-- Uncomment the line below for debugging purposes
-- display(2, matches[2], 3, matches[3], 4, matches[4], 5, matches[5], 6, matches[6], 7, matches[7], 8, matches[8])

local H = matches[3]
local h = calendar.string2int[matches[3]]
local pd = matches[4]
local m = matches[6]

-- Calculate the day of the month
local d = calendar.string2int[matches[5]]
-- Calculate the day of the year based on "czas"
local yd = calendar.ishtar.settings.first_day_of_calparts[m] + d - 1

if pd == "wieczorem" or pd == "poludniu" or (pd == "nocy" and h &gt; 7) then
  h = h + 12
end

calendar.ishtar.data.precision = 119 -- After "czas" command, precision changes to max error of 119 sec
calendar.ishtar = calendar.refresh_calendar(calendar.ishtar, yd, h)

-- Uncomment the line below to display debug information
-- display("dzien", d, "miesiac", m, "dzien roku", yd, "godzina pory", H, "pora dnia", pd, "godzina row", h)
</script>
				<triggerType>0</triggerType>
