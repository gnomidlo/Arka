-- Define a debug variable
local debug = false

-- Define a function to print logs
function print_log(message)
  cecho("<yellow>" .. message .. "\n")
end

-- Function to get prefix based on type
function calendar.get_prefix(type)
  local arr = string.split(type, "_")
  local domain = arr[#arr]
  if domain == "imperial" then
    return "<aquamarine>[<light_goldenrod>Imperium<aquamarine>]<reset> "
  elseif domain == "ishtar" then
    return "<aquamarine>[<cornflower_blue>Ishtar<aquamarine>]<reset> "
  end
  return ""
end

-- Function to check if filters contain only one domain
function calendar.check_filters(filters)
  if not filters or #filters == 0 then return false end
  local first_prefix = calendar.get_prefix(filters[1])
  if first_prefix == "" then return true end -- Return true if no specific domain prefix
  for i = 2, #filters do
    if first_prefix ~= calendar.get_prefix(filters[i]) then
       return false
    end
  end
  return true
end

-- Create calendar data with timestamps
function calendar.create_calendar(cal, offset)
  local timestamp = offset
  local type = ""
  if offset == nil then
    if debug then
      print_log("Błąd w narzutu kalendarza: "..cal.config.name.." -> "..offset) 
    end  
    return cal
  end

  if offset == 0 then
    type = "template"
  elseif offset > 0 then
    type = "calendar"
  end
  if string.len(type) > 0 then
    cal.data[type] = {}
    for i=1,tonumber(cal.config.days_in_year) do
      cal.data[type][i] = {}
      for j=0,23 do
        cal.data[type][i][j] = timestamp
        timestamp = timestamp + calendar.gamehour_real_time
    
      end
    end
    if offset > 0 then
      cal.data.offset = offset
      cal = calendar.reload_calendar(cal)
    end
  else
    if debug then
      print_log("Błąd w narzutu kalendarza: "..cal.config.name.." -> "..offset) 
    end  
  end
  return cal
end

-- Refresh calendar data based on current time
function calendar.refresh_calendar(cal, d, h)
  cal.data.offset = getEpoch() - cal.data.template[d][h]
  cal = calendar.create_calendar(cal, cal.data.offset)
  calendar.domain = cal.config.domain
  calendar.save_local_time_data(cal)
  return calendar.reload_calendar(cal)
end

-- Reload event timestamps
function calendar.reload_calendar(cal)
  local function fill_time(a, b, add)
    if a >= b then
      return a
    end
    local n = math.ceil((b - a) / add)
    return a + n * add
  end
  if table_size(cal.data.calendar) > 0 then
    cal.data.results = {}
    local t = 0
    local et = getEpoch()
    local day = 0
    for k, v in pairs(cal.config.search_times) do
      day = tonumber(v.day)
      t = cal.data.calendar[day][v.hour]
      if t < et then
        t = fill_time(t, et, cal.config.year_time)
      end
      if not cal.data.results[t] then  -- Avoid duplicates
        cal.data.results[t] = { desc = v.desc, timestamp = t, color = v.color, type = v.type, precision = cal.data.precision, 
                     game_date = "("..calendar.get_gamedate(cal, day, v.hour)..")"} 
      end
    end
    -- Convert results to a list
    local results_list = {}
    for _, event in pairs(cal.data.results) do
      table.insert(results_list, event)
    end
    cal.data.results = results_list
  else
    if debug then
      print_log("Błąd w przeladowaniu kalendarza: "..cal.config.name) 
    end  
  end
  return cal
end



-- Get game time based on timestamp and domain
function calendar.get_game_time(timestamp, domain)
  if timestamp == nil then
    timestamp = getEpoch()
  end
  timestamp = tonumber(timestamp)
  if domain == nil then
    domain = calendar.domain
  end
  if calendar[domain] == nil or calendar[domain].data == nil then
    return ""
  end
  
  local cal = calendar.create_calendar(calendar[domain], calendar[domain].data.offset)
  local tmp = {}
  local checked_time = false
  for a,v in pairs(cal.data.calendar) do
    for b,t in pairs(v) do
      if t >= timestamp then
        checked_time = true
      end
      tmp[t] = a.."_"..b
    end
  end
  
 
  local t = timestamp
  if not checked_time then
    t = timestamp - cal.data.offset
  end
  
  local r = {}
  
  local function pairsByKeys (t, f)
    local a = {}
    for n in pairs(t) do table.insert(a, n) end
    table.sort(a, f)
    local i = 0
    local iter = function ()
      i = i + 1
      if a[i] == nil then return nil
      
      else return a[i], t[a[i]]
      end
    end
    return iter
  end
     
  for k,v in pairsByKeys(tmp) do
    if k >= timestamp then
      break
    end
    r = string.split(v, "_")
  end
  if table_size(r) > 1 then
    return calendar.get_gamedate(cal, r[1], r[2])
  else
    return ""
  end
end

-- Get combined event results
function calendar.get_events_results()
  if table_size(calendar.imperial.data.calendar) > 0 then
    calendar.imperial = calendar.reload_calendar(calendar.imperial)
  end
  if table_size(calendar.ishtar.data.calendar) > 0 then
    calendar.ishtar = calendar.reload_calendar(calendar.ishtar)
  end
  
  local function comp(a, b)
    if a["timestamp"] < b["timestamp"] then
      return true
    end
    return false
  end
  
  local union = {}
  
  if table_size(calendar.imperial.data.calendar) > 0 and table_size(calendar.ishtar.data.calendar) > 0 then
    union = table_n_union(calendar.imperial.data.results, calendar.ishtar.data.results)
  elseif table_size(calendar.imperial.data.calendar) > 0 then
    union = calendar.imperial.data.results
  elseif table_size(calendar.ishtar.data.calendar) > 0 then
    union = calendar.ishtar.data.results
  end

  table.sort(union, comp)
  return union
end

-- Function to format remaining time
function calendar.resttime(time)
  local ret = ""
  if time > 0 then
    local days = math.floor(time/86400)
    local remaining = time % 86400
    local hours = math.floor(remaining/3600)
    remaining = remaining % 3600
    local minutes = math.floor(remaining/60)
    remaining = remaining % 60
    local seconds = math.floor(remaining)
    
    if days > 0 then
      ret = days.."d "..hours.."h "..minutes.."m "..seconds.."s"
    elseif days == 0 and hours > 0 then
      ret = hours.."h "..minutes.."m "..seconds.."s"
    elseif days == 0 and hours == 0 and minutes > 0 then
      ret = minutes.."m "..seconds.."s"
    elseif days == 0 and hours == 0 and minutes == 0 then
      ret = seconds.."s"
    end
  end
  return ret
end

-- Show calendar results based on filters
function calendar.show_calendar_results(filters, in_real_days)
  local now = getEpoch()
  local time = 0
  local t = 0
  local desc_type = calendar.check_filters(filters)
  
  if in_real_days ~= nil then
    in_real_days = tonumber(in_real_days)  -- Convert to number
    if in_real_days ~= nil then
  
      time = in_real_days * 24 * 60 * 60
    else
      time = 0
      if debug then
        print_log("Invalid in_real_days value; defaulting time to 0.")
      end
    end
  end
  
  if debug then
  print_log("in_real_days: " .. tostring(in_real_days))
  print_log("time (seconds): " .. tostring(time))
  print_log("Event t: " .. tostring(t))
end

  
  local union = calendar.get_events_results()
  local c = "<wheat>"
  for k, v in pairs(union) do
    if v["precision"] == 0 then
      c = "<gold>"
    else
      c = "<wheat>"
    end
    if filters == nil or table_contains(filters, v["type"]) then
      t = v["timestamp"] - now
      local output_line = ""
      if desc_type then
        output_line = string.format("<%s>%s <white>%s <yellow>-> %sza %s <gray>%s\n", v["color"], v["desc"], os.date('%d.%m.%Y %H:%M:%S', v["timestamp"]), c, calendar.resttime(t), v["game_date"])
      else
        output_line = string.format("%s<%s>%s <white>%s <yellow>-> %sza %s <gray>%s\n", calendar.get_prefix(v["type"]), v["color"], v["desc"], os.date('%d.%m.%Y %H:%M:%S', v["timestamp"]), c, calendar.resttime(t), v["game_date"])
      end

      if time > 0 then
        if t >= 0 and t <= time then
          cecho(output_line)
        end
      else
        cecho(output_line)
      end
    end
  end  
end




-- Save offsets to local JSON
function calendar.save_local_time_data()
  local data = {
    imperial_offset = calendar["imperial"].data.offset, 
    ishtar_offset = calendar["ishtar"].data.offset, 
 
  }
  
  local path = calendar.json_file_path
  local file = io.open(path, "w")
  file:write(yajl.to_string(data))
  file:close()
  if debug then
    print_log("Zapisano lokalny narzut czasow kalendarzy:")
    display(data)
  end
end

-- Read offsets from local JSON
function calendar.read_local_time_data()
  if io.exists(calendar.json_file_path) then
    local file = io.open(calendar.json_file_path, "r")
    local content = file:read("*a")
    file:close()
    local data = yajl.to_value(content)
    if data["imperial_offset"] ~= nil and tonumber(data["imperial_offset"]) > 0 then
      calendar.imperial = calendar.create_calendar(calendar.imperial, data["imperial_offset"])
    end
    if data["ishtar_offset"] ~= nil and tonumber(data["ishtar_offset"]) > 0 then
      calendar.ishtar = calendar.create_calendar(calendar.ishtar, data["ishtar_offset"])
    end
    
    if debug then
      print_log("Zaladowano lokalny narzut czasow kalendarzy.") 
      display("json", data)
    end
  end  
end

-- Initialize calendars on Mudlet startup
function calendar.init()
  calendar.imperial = calendar.create_calendar(calendar.imperial, 0)
  calendar.ishtar = calendar.create_calendar(calendar.ishtar, 0)
  calendar.read_local_time_data()
  calendar.init_gmcp()

  -- Pre-sort tables for optimization
  for _, cal in pairs({calendar.imperial, calendar.ishtar}) do
      table.sort(cal.config.seasons, function(a, b) return a.day < b.day end)
      cal.config.sorted_months = {}
      for name, start_day in pairs(cal.config.first_day_of_calparts) do
        table.insert(cal.config.sorted_months, {name = name, start = start_day})
      end
      table.sort(cal.config.sorted_months, function(a,b) return a.start < b.start end)
  end
end


-- Initialize GMCP handlers
function calendar.init_gmcp()
  if event_handlers and event_handlers["calendar_time"] then
    killAnonymousEventHandler(event_handlers["calendar_time"])
  end
  event_handlers = event_handlers or {}
  event_handlers["calendar_time"] = registerAnonymousEventHandler("gmcp.room.time", calendar.handle_gmcp_time)
  if event_handlers["calendar_domain"] then
    killAnonymousEventHandler(event_handlers["calendar_domain"])
  end
  event_handlers["calendar_domain"] = registerAnonymousEventHandler("gmcp.room.info.map", calendar.handle_gmcp_domain)
end

-- Update calendar based on GMCP time change
function calendar.handle_gmcp_time()
  local timestamp = getEpoch()
  if calendar.domain == "ishtar" and calendar.ishtar.data.precision > 0 then
    calendar.update_calendar_by_precision(calendar.ishtar, timestamp)
  elseif calendar.domain == "imperial" and calendar.imperial.data.precision > 0 then
    calendar.update_calendar_by_precision(calendar.imperial, timestamp)
  else
    if debug then
      print_log("Zmiana czasu w nieznanej domenie: "..calendar.domain) 
    end
  end
end

-- Set domain based on location change
function calendar.handle_gmcp_domain()
  if gmcp ~= nil and gmcp.char ~= nil and gmcp.char.info ~= nil and gmcp.char.info.map ~= nil then
    if gmcp.room.info.map ~= nil then
      if gmcp.room.info.map.domain == "Imperium" then
        calendar.domain = "imperial"
      end
      if gmcp.room.info.map.domain == "Ishtar" then
        calendar.domain = "ishtar"
      end
    end
  end
end

-- Update dynamic calendar data based on precision
function calendar.update_calendar_by_precision(cal, timestamp)
  local diff = 0
  cal.data.precision = 0
  for d,v in pairs(cal.data.calendar) do
    for h,t in pairs(v) do
      diff = timestamp - t
      if diff == 0 or (diff > 0 and diff < calendar.gamehour_real_time) then
        if debug then
       
           print_log("Poprawiono dokladnosc pomiaru kalendarza do 0 sekund: "..cal.config.name) 
        end       
        calendar.refresh_calendar(cal, d, h)
      end
    end
  end
  if debug then
    print_log("update_calendar_by_precision") 
  end  
end

-- Get day and month based on day of the year
function calendar.get_monthday(cal, day)
  local c = {}
  for k,v in pairs(cal.config.first_day_of_calparts) do
    table.insert(c, { month=k, start=v })
  end
  local function comp(a,b)  
   
    return a["start"] > b["start"]
  end
  table.sort(c, comp)
  
  local next_month_start = 0
  local month_start = cal.config.days_in_year
  local tmp = false
  local month = "nieznany1"
  local next_month = "nieznany2"

  for _,v in ipairs(c) do
    if cal.config.first_day_of_calparts[v.month] == day then
      return {day=1, month=v.month}
    end
    if tmp then
      next_month_start = v.start-1
      next_month = v.month
      tmp = false
   
       break
    end
    if v.start <= day then
      month = v.month
      month_start = (v.start-1)
      tmp = true
    end
  end
  local ret = day-month_start
  return {day=ret, month=month}
end

-- Get game date string
function calendar.get_gamedate(cal, ds, h)
  local dd = calendar.get_monthday(cal, tonumber(ds))
  return dd["day"]..". "..dd["month"].." o "..h..":00 ["..ds.."]"
end

-- Function to check if a table contains a value
function table_contains(t, val)
  for _, v in pairs(t) do
    if v == val then return true end
  end
  return false
end

-- Function to get the size of a table
function table_size(t)
  local count = 0
  for _ in pairs(t) do count = count + 1 end
  return count
end

-- Function to merge two tables
function table_n_union(t1, t2)
  local res = {}
  for _, v in ipairs(t1) do table.insert(res, v) end
  for _, v in ipairs(t2) do table.insert(res, v) end
  return res
end

function calendar.get_current_season(cal, day)
    local current_season = "Nieznana"
    for _, season in ipairs(cal.config.seasons) do
        if tonumber(day) >= tonumber(season.day) then
            current_season = season.name
        else
            break
        end
    end
    return current_season
end

function calendar.get_month_info(cal, day)
    local sorted_months = cal.config.sorted_months
    
    local current_month = {name = "Unknown", day = 0, length = 0}
    
    for i = #sorted_months, 1, -1 do
        local month = sorted_months[i]
        if tonumber(day) >= tonumber(month.start) then
            current_month.name = month.name
            current_month.day = tonumber(day) - tonumber(month.start) + 1
            if i < #sorted_months then
                current_month.length = sorted_months[i+1].start - month.start
            else
                current_month.length = cal.config.days_in_year - month.start + 1
            end
            break 
        end
    end
    return current_month
end

function calendar.time_to_minutes(time_str)
    local h, m = time_str:match("(%d+):(%d+)")
    return tonumber(h) * 60 + tonumber(m)
end

function calendar.minutes_to_time(minutes)
    local h = math.floor(minutes / 60)
    local m = math.floor(minutes % 60)
    return string.format("%02d:%02d", h, m)
end

function calendar.get_sunrise_sunset(cal, day)
    local cycle = cal.config.sun_cycle
	day = tonumber(day)
    table.sort(cycle, function(a,b) return a.day < b.day end)

    local p1, p2
    
    if day < cycle[1].day then
        p1 = cycle[#cycle]
        p2 = cycle[1]
    else
        for i = 1, #cycle do
            if day >= cycle[i].day then
                p1 = cycle[i]
                if i == #cycle then
                    p2 = cycle[1] 
                else
                    p2 = cycle[i+1]
                end
            else
                break
            end
        end
    end

    if not p1 or not p2 then
        return { sunrise = "06:00", sunset = "18:00", sunrise_rl = "??:??", sunset_rl = "??:??" }
    end

    local total_days_in_period
    if p2.day < p1.day then
        total_days_in_period = (cal.config.days_in_year - p1.day) + p2.day
    else
        total_days_in_period = p2.day - p1.day
    end
	
	if total_days_in_period == 0 then
		local sunrise_ts = cal.data.calendar[day][0] + (calendar.time_to_minutes(p1.sunrise) * (calendar.gamehour_real_time/60))
		local sunset_ts = cal.data.calendar[day][0] + (calendar.time_to_minutes(p1.sunset) * (calendar.gamehour_real_time/60))
		return { sunrise = p1.sunrise, sunset = p1.sunset, sunrise_rl = os.date("%H:%M", sunrise_ts), sunset_rl = os.date("%H:%M", sunset_ts) }
	end

    local days_into_period
    if day < p1.day then 
        days_into_period = (cal.config.days_in_year - p1.day) + day
    else
        days_into_period = day - p1.day
    end

    local progress = days_into_period / total_days_in_period

    local sunrise1_min = calendar.time_to_minutes(p1.sunrise)
    local sunrise2_min = calendar.time_to_minutes(p2.sunrise)
    local sunset1_min = calendar.time_to_minutes(p1.sunset)
    local sunset2_min = calendar.time_to_minutes(p2.sunset)

    local current_sunrise_min = sunrise1_min + (sunrise2_min - sunrise1_min) * progress
    local current_sunset_min = sunset1_min + (sunset2_min - sunset1_min) * progress

	local sunrise_timestamp = cal.data.calendar[day][0] + (current_sunrise_min * (calendar.gamehour_real_time/60))
	local sunset_timestamp = cal.data.calendar[day][0] + (current_sunset_min * (calendar.gamehour_real_time/60))

    return {
        sunrise = calendar.minutes_to_time(current_sunrise_min),
        sunset = calendar.minutes_to_time(current_sunset_min),
		sunrise_rl = os.date("%H:%M", sunrise_timestamp),
		sunset_rl = os.date("%H:%M", sunset_timestamp)
    }
end

function calendar.display_full_time_info(cal, day, hour)
	local day_num = tonumber(day)
	if not day_num or not cal.data.calendar[day_num] then return end

	local season = calendar.get_current_season(cal, day_num)
	local month_info = calendar.get_month_info(cal, day_num)
	local sun_times = calendar.get_sunrise_sunset(cal, day_num)
	
	local next_events = calendar.get_next_three_events()
	
	local line1 = string.format("<light_steel_blue>%-10s <white>%-17s <aquamarine>|| <light_steel_blue>%-8s <white>%-10s <aquamarine>|| <light_steel_blue>%-12s <white>%s", "MIESIAC:", month_info.name, "DZIEN:", month_info.day.."/"..month_info.length, "PORA ROKU:", season)
	local line2 = string.format("<light_steel_blue>%-10s <white>%s <light_slate_grey>(rl: %s) <aquamarine>|| <light_steel_blue>%-8s <white>%s <light_slate_grey>(rl: %s)", "SWIT:", sun_times.sunrise, sun_times.sunrise_rl, "ZMIERZCH:", sun_times.sunset, sun_times.sunset_rl)
	local hour_line = string.format("<light_steel_blue>GODZINA:   <aquamarine>%d:00", hour)
	
	local events_string = ""
	if #next_events > 0 then
		local events_list = {}
		for i, event in ipairs(next_events) do
			local remaining_time = event.timestamp - getEpoch()
			if remaining_time > 0 then
				table.insert(events_list, string.format("  %d. %s<%s>%s<reset> %s -> <wheat>za %s", i, calendar.get_prefix(event.type), event.color, event.desc:gsub("%s+$", ""), os.date('%d.%m.%Y %H:%M:%S', event.timestamp), calendar.resttime(remaining_time)))
			end
		end
		events_string = table.concat(events_list, "\n")
	else
		events_string = "  <dim_gray>Brak nadchodzących wydarzeń"
	end

	cecho("\n<reset>"..hour_line.."\n"..line1.."\n"..line2.."\n".."<light_steel_blue>ZBLIZAJA SIE:\n<reset>"..events_string.."\n")
end


-- Funkcja do pobierania najbliższych trzech nadchodzących wydarzeń
function calendar.get_next_three_events(filters)
    local now = getEpoch()
    local union = calendar.get_events_results()
    local next_events = {}
    
    for _, event in ipairs(union) do
        if (filters == nil or table_contains(filters, event.type)) and event.timestamp >= now then
            table.insert(next_events, event)
            if #next_events == 3 then
                break
            end
        end
  
    end

    -- Debugowanie
    if debug then
        print_log("Najbliższe trzy wydarzenia:")
        for i, evt in ipairs(next_events) do
            print_log(string.format("%d: %s at %s", i, evt.desc, os.date('%d.%m.%Y %H:%M:%S', evt.timestamp)))
        end
    end
    
    return next_events
end

function calendar.recalibrate_by_event(cal_name, event_type)
	if not calendar[cal_name] or not calendar[cal_name].data.offset or calendar[cal_name].data.offset == 0 then return end
	
	local cal = calendar[cal_name]
	local now = getEpoch()

	-- Mathematically calculate current game day
	local seconds_in_game_day = 24 * calendar.gamehour_real_time
	local elapsed_time_in_year = (now - cal.data.offset) % cal.config.year_time
	local current_game_day_approx = math.floor(elapsed_time_in_year / seconds_in_game_day) + 1

	if not current_game_day_approx then return end

	local sun_times = calendar.get_sunrise_sunset(cal, current_game_day_approx)
	local event_time_str
	if event_type == "sunrise" then
		event_time_str = sun_times.sunrise
	elseif event_type == "sunset" then
		event_time_str = sun_times.sunset
	else
		return
	end

	local event_minutes = calendar.time_to_minutes(event_time_str)
	local event_seconds_into_day = event_minutes * (calendar.gamehour_real_time / 60)
	
	-- Calculate the timestamp for the start of the game day
	local day_start_timestamp_template = cal.data.template[current_game_day_approx][0]

	-- The precise time of the event is `now`.
	-- The expected time of the event (in seconds from year start) is `day_start_timestamp_template + event_seconds_into_day`.
	local new_offset = now - (day_start_timestamp_template + event_seconds_into_day)

	-- Apply the new offset and reload
	cal.data.offset = new_offset
	calendar[cal_name] = calendar.create_calendar(cal, new_offset)
	cecho(string.format("<light_steel_blue>Kalendarz (%s) został automatycznie zsynchronizowany.\n", cal.config.name))
end


-- Initialize the calendar module
calendar.init()

