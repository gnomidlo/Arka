				<colorTriggerFgColor>#000000</colorTriggerFgColor>
				<colorTriggerBgColor>#000000</colorTriggerBgColor>
				<regexCodeList>
					<string>(^Jest w przyblizeniu (\w+) (?:|w|po|przed|nad|poznym)\s*(dzien|nocy|poludniu|poludniem|poludnie|rano|ranem|wieczorem).*, (.*) dzien pory (\w+))</string>
				</regexCodeList>
				<regexCodePropertyList>
					<integer>1</integer>
				</regexCodePropertyList>
			</Trigger>
			<Trigger isActive="yes" isFolder="no" isTempTrigger="no" isMultiline="no" isPerlSlashGOption="no" isColorizerTrigger="no" isFilterTrigger="no" isSoundTrigger="no" isColorTrigger="no" isColorTriggerFg="no" isColorTriggerBg="no">
				<name>kalendarz imperium</name>
				<script>local cm = table_size(matches)

-- Uncomment the line below for debugging purposes
-- display("count: "..table_size(matches), 3, matches[3], 4, matches[4], 5, matches[5], 6, matches[6], 7, matches[7], 8, matches[8])

local yd = 0

local H = matches[3]
local h = calendar.string2int[matches[3]]
local pd = matches[4]

local m = matches[5]

if cm &gt; 5 then
  m = matches[6]
end

local d = "-"

local special_imperial_days = {"Hexentag", "Mitterfruhl", "Sonnenstill", "Geheimnistag", "Mitterherbst"}

-- For special days, the day of the year is determined directly from calparts definitions
if table_contains(special_imperial_days, m) then 
  yd = calendar.imperial.settings.first_day_of_calparts[m]
else
  d = calendar.string2int[matches[5]]
  -- Calculate the day of the year based on "czas"
  yd = calendar.imperial.settings.first_day_of_calparts[m] + d - 1
end

if pd == "wieczorem" or pd == "poludniu" or (pd == "nocy" and h &gt; 8) then
  h = h + 12
end

calendar.imperial.data.precision = 119 -- After "czas" command, precision changes to max error of 119 sec
calendar.imperial = calendar.refresh_calendar(calendar.imperial, yd, h)
-- Uncomment the line below to display debug information
-- display("dzien", d, "miesiac", m, "dzien roku", yd, "godzina pory", H, "pora dnia", pd, "godzina row", h)
</script>
