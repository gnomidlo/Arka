<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE MudletPackage>
<MudletPackage version="1.0.0">
    <ScriptPackage>
        <ScriptGroup name="MieszankiManager" isActive="yes">
            <Script name="Glowna logika" isActive="yes" isFolder="no">
                <code encoding="UTF-8"><![CDATA[-- =============================================================================
--
-- MieszankiManager v3.0 - Modul do Zielenie 7.0
--
-- =============================================================================

MieszankiManager = MieszankiManager or {}
MieszankiManager.db = MieszankiManager.db or {}
MieszankiManager.config = MieszankiManager.config or {}
MieszankiManager.config.db_filename = MieszankiManager.config.db_filename or "moje_mieszanki.json"
MieszankiManager.config.command_delay = MieszankiManager.config.command_delay or 1.2
if MieszankiManager.config.debug == nil then MieszankiManager.config.debug = false end
MieszankiManager.config.colors = MieszankiManager.config.colors or {
    border = "light_steel_blue", title = "dodger_blue", header = "powder_blue",
    command = "khaki", description = "white", positive = "pale_green",
    negative = "salmon", neutral = "grey", ingredient = "light_cyan"
}

--- GLOWNA FUNKCJA OBSLUGUJACA WSZYSTKIE KOMENDY ---
function MieszankiManager:uruchomKomende(input)
    local C = self.config.colors
    local input = (input or ""):trim()
    local cmd = string.match(input, "^(%S+)") or ""
    local params = string.match(input, "^%S+%s+(.*)$") or ""

    if cmd == "pomoc" or cmd == "" then
        -- INTELIGENTNA POMOC - Sprawdza czy istnieje HerbalismSystem
        if _G.HerbalismSystem and HerbalismSystem.showHelp then
            HerbalismSystem:showHelp() -- Uzywamy pomocy z glownego skryptu
        else
            cecho(string.format("\n<%s>━━━━━━━━━━━<reset><%s> Pomoc Systemu Mieszanek <%s>━━━━━━━━━━━\n", C.border, C.title, C.border))
        end
        
        cecho(string.format("<%s>  Zarzadzanie Mieszankami\n", C.header))
        cecho(string.format("<%s>    /zi przeladuj <%s>- Wczytuje baze mieszanek z pliku.\n", C.command, C.description))
        cecho(string.format("<%s>    /zi lista     <%s>- Wyswietla wszystkie zdefiniowane mieszanki.\n", C.command, C.description))
        cecho(string.format("<%s>    /zi sprawdz   <%s>- Pokazuje, ile pelnych mieszanek mozesz stworzyc.\n", C.command, C.description))
        cecho(string.format("<%s>    /zi pokaz <%s><id><%s> - Pokazuje skladniki i stan posiadania dla mieszanki.\n", C.command, C.neutral, C.description))
        cecho(string.format("<%s>    /zi pakuj <%s><id> <ilosc> do <numer.><%s> - Pakuje dana mieszanke.\n", C.command, C.neutral, C.description))
        cecho(string.format("<%s>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n", C.border))

    elseif cmd == "przeladuj" then
        self:wczytajDB()
    elseif cmd == "debug" then
        self:toggleDebug()
    elseif cmd == "lista" then
        if not self.db or table.is_empty(self.db) then
            cecho(string.format("<%s>!! Baza mieszanek jest pusta. Uzyj /zi przeladuj.\n", C.negative))
            return
        end
        cecho(string.format("<%s>--[ <%s>Zdefiniowane Mieszanki<%s> ]--\n", C.border, C.title, C.border))
        for id, definicja in pairs(self.db) do
            local nazwa = definicja.nazwa or "Brak nazwy"
            local padding = string.rep(" ", 30 - #nazwa)
            cecho(string.format("<%s>    %s%s- <%s>%s\n", C.positive, nazwa, padding, C.neutral, id))
        end
        cecho(string.format("<%s>--------------------------------\n", C.border))
    elseif cmd == "pokaz" then
        local id = params:trim()
        if id == "" then
            cecho(string.format("<%s>!! Podaj ID mieszanki, ktora chcesz wyswietlic.\n", C.negative))
            cecho(string.format("<%s>   Przyklad: /zi pokaz hp\n", C.command))
            return
        end
        local definicja = self.db[id]
        if definicja then
            local ilosc_mieszanek, _ = self:obliczDostepne(id)
            cecho(string.format("<%s>--[ <%s>Mieszanka: %s<%s> | <%s>Mozna stworzyc: %d<%s> ]--\n", C.border, C.title, definicja.nazwa, C.border, C.command, ilosc_mieszanek, C.border))
            local posiadane_ziola = herbs.counts or {}
            for _, nazwa_ziola in ipairs(definicja.skladniki) do
                local czysta_nazwa = nazwa_ziola:trim()
                local ilosc = posiadane_ziola[czysta_nazwa] or 0
                local kolor_nazwy = ilosc > 0 and C.ingredient or C.negative
                local kolor_ilosci = ilosc > 0 and C.positive or C.negative
                local padding = string.rep(" ", 25 - #czysta_nazwa)
                cecho(string.format("<%s>    %s%s: <%s>%d\n", kolor_nazwy, czysta_nazwa, padding, kolor_ilosci, ilosc))
            end
            cecho(string.format("<%s>---------------------------------------------------------\n", C.border))
        else
            cecho(string.format("<%s>!! Nie ma mieszanki o ID: '%s'.\n", C.negative, id))
        end
    elseif cmd == "sprawdz" then
        self:wyswietlPodsumowanie()
    elseif cmd == "pakuj" then
        local id, ilosc, nr_woreczka = string.match(params, "^(%S+)%s+(%d+)%s+do%s+(%d+%.?)$")
        if not (id and ilosc and nr_woreczka) then
            cecho(string.format("<%s>!! Bledna skladnia. Poprawna forma:\n", C.negative))
            cecho(string.format("<%s>   /zi pakuj <id> <ilosc> do <numer.>\n", C.command))
            return
        end
        self:pakuj(id:trim(), tonumber(ilosc), nr_woreczka:trim())
    else
        -- Jesli komenda nie jest znana, przekaz ja do glownego systemu (jesli istnieje)
        if _G.HerbalismSystem and HerbalismSystem.handleZiAlias then
            -- Tworzymy tymczasowa tablice 'matches', aby oszukac stary system
            matches = { [0] = "/zi " .. input, [1] = " " .. input, [2] = input }
            HerbalismSystem:handleZiAlias()
            matches = nil -- czyscimy
        else
            cecho(string.format("<%s>!! Nieznana komenda: '%s'. Wpisz /zi pomoc.\n", C.negative, cmd))
        end
    end
end

function MieszankiManager:wczytajDB()
    local C = self.config.colors
    local sciezka = getMudletHomeDir() .. "/" .. self.config.db_filename
    if io.exists(sciezka) then
        local file_handle, err = io.open(sciezka, "r")
        if not file_handle then
            cecho(string.format("<%s>!! Blad: Nie mozna otworzyc pliku %s: %s\n", C.negative, self.config.db_filename, tostring(err)))
            return
        end
        local file_content = file_handle:read("*all")
        file_handle:close()
        local status, data = pcall(yajl.to_value, file_content)
        if status then
            self.db = data
            cecho(string.format("<%s>-> Pomyslnie wczytano %d definicji mieszanek.\n", C.positive, table.size(self.db)))
        else
            cecho(string.format("<%s>!! Blad przetwarzania pliku %s (sprawdz jego skladnie): %s\n", C.negative, self.config.db_filename, tostring(data)))
        end
    else
        cecho(string.format("<khaki>!! Uwaga: Nie znaleziono pliku '%s'. Uzyj /zi pomoc.\n", self.config.db_filename))
    end
end

function MieszankiManager:obliczDostepne(id_mieszanki)
    local definicja = self.db[id_mieszanki]
    if not definicja or not definicja.skladniki then return 0, nil end
    local posiadane_ziola = herbs.counts or {}
    local max_mozliwych = math.huge
    local brakujace_ziola = {}
    for _, nazwa_ziola in ipairs(definicja.skladniki) do
        local czysta_nazwa = nazwa_ziola:trim()
        local ilosc_posiadana = posiadane_ziola[czysta_nazwa] or 0
        if ilosc_posiadana == 0 then
            table.insert(brakujace_ziola, czysta_nazwa)
        end
        max_mozliwych = math.min(max_mozliwych, ilosc_posiadana)
    end
    if #brakujace_ziola > 0 then
        return 0, brakujace_ziola
    end
    local final_count = (max_mozliwych == math.huge) and 0 or max_mozliwych
    return final_count, nil
end

function MieszankiManager:wyswietlPodsumowanie()
    local C = self.config.colors
    if not self.db or table.is_empty(self.db) then
        cecho(string.format("<%s>Brak zdefiniowanych mieszanek. Sprawdz plik lub uzyj /zi przeladuj.\n", C.negative))
        return
    end
    if self.config.debug then
        cecho(string.format("<%s>---[ TRYB DIAGNOSTYCZNY: ZAWARTOSC BAZY ZIOL (herbs.counts) ]---\n", C.command))
        if herbs.counts and not table.is_empty(herbs.counts) then
            local nazwy_ziol = {}
            for nazwa, ilosc in pairs(herbs.counts) do table.insert(nazwy_ziol, string.format("  \"%s\": %d", nazwa, ilosc)) end
            table.sort(nazwy_ziol)
            for _, linia in ipairs(nazwy_ziol) do cecho(string.format("<%s>%s\n", C.neutral, linia)) end
        else
            cecho(string.format("<%s>!! Tabela 'herbs.counts' jest pusta lub nie istnieje!\n", C.negative))
        end
        cecho(string.format("<%s>----------------------------------------------------------------\n", C.command))
    end
    cecho(string.format("<%s>--[ <%s>Podsumowanie Dostepnych Mieszanek<%s> ]--\n", C.border, C.title, C.border))
    for id, definicja in pairs(self.db) do
        local ilosc, brakujace = self:obliczDostepne(id)
        local kolor = ilosc > 0 and C.positive or C.negative
        local info = ""
        if brakujace and #brakujace > 0 then
            info = string.format("<%s> (Brak: %s)", C.neutral, table.concat(brakujace, ", "))
        end
        local text_bez_koloru = string.format("%-25s: %d szt.%s", definicja.nazwa, ilosc, info)
        local komenda_do_uruchomienia = string.format([[MieszankiManager:uruchomKomende("pokaz %s")]], id)
        local podpowiedz = "Kliknij, aby zobaczyc szczegoly i stan skladnikow"
        cecho("    ")
        fg(kolor)
        cechoLink(text_bez_koloru, komenda_do_uruchomienia, podpowiedz, false)
        resetFormat()
        cecho("\n")
    end
    cecho(string.format("<%s>------------------------------------------\n", C.border))
end

function MieszankiManager:uruchomKolejkeKomend(lista_komend, idx)
    local C = self.config.colors
    idx = idx or 1
    if not lista_komend[idx] then
        cecho(string.format("<%s>-> Zakonczono kolejke polecen.\n", C.positive))
        return
    end
    local komenda = lista_komend[idx]
    send(komenda)
    cecho(string.format("<%s>Wyslano (%d/%d): %s\n", C.neutral, idx, #lista_komend, komenda))
    tempTimer(self.config.command_delay, function()
        self:uruchomKolejkeKomend(lista_komend, idx + 1)
    end)
end

function MieszankiManager:pakuj(id_mieszanki, ilosc, nr_woreczka)
    local C = self.config.colors
    local definicja = self.db[id_mieszanki]
    if not definicja then
        cecho(string.format("<%s>!! Blad: Nie znaleziono mieszanki o ID: '%s'.\n", C.negative, id_mieszanki))
        return
    end
    local dostepne, brakujace = self:obliczDostepne(id_mieszanki)
    if dostepne < ilosc then
        local info = ""
        if brakujace and #brakujace > 0 then
            info = string.format(" Brakuje Ci: %s.", table.concat(brakujace, ", "))
        end
        cecho(string.format("<%s>!! Blad: Chcesz spakowac %d, a masz skladniki tylko na %d.%s\n", C.negative, ilosc, dostepne, info))
        return
    end
    cecho(string.format("<%s>Rozpoczynam pakowanie %d x '%s' do woreczka %s...\n", C.command, ilosc, definicja.nazwa, nr_woreczka))
    local kolejka = {}
    cecho(string.format("<%s>-> Etap 1: Wyjmowanie skladnikow...\n", C.ingredient))
    for _, nazwa_ziola in ipairs(definicja.skladniki) do
        herbs:get_herbs(nazwa_ziola:trim(), ilosc)
    end
    cecho(string.format("<%s>-> Etap 2: Wkladanie ziol do docelowego woreczka...\n", C.ingredient))
    table.insert(kolejka, "echem")
    table.insert(kolejka, string.format("otworz %s swoj woreczek", nr_woreczka))
    table.insert(kolejka, string.format("wloz ziola do %s swojego woreczka", nr_woreczka))
    table.insert(kolejka, string.format("zamknij %s swoj woreczek", nr_woreczka))
    self:uruchomKolejkeKomend(kolejka)
end

function MieszankiManager:toggleDebug()
    local C = self.config.colors
    self.config.debug = not self.config.debug
    local status = self.config.debug and string.format("<%s>WLACZONY", C.positive) or string.format("<%s>WYLACZONY", C.negative)
    cecho(string.format("<%s>-> Tryb diagnostyczny jest teraz %s.\n", C.command, status))
end

registerAnonymousEventHandler("herbsDatabaseBuilt", function()
    MieszankiManager:wyswietlPodsumowanie()
end)

MieszankiManager:wczytajDB()
]]></code>
            </Script>
            <AliasPackage>
                <AliasGroup name="Aliasy Mieszanek" isActive="yes">
                    <Alias isActive="yes" isFolder="no" matchingMethod="3" ignoreCase="yes" useWildcards="no">
                        <name>Glowny alias /zi (Mieszanki)</name>
                        <script><![CDATA[-- Ten alias przechwytuje teraz wszystkie komendy /zi
-- i przekazuje je do centralnej funkcji w skrypcie MieszankiManager,
-- ktora decyduje, co zrobic dalej.

MieszankiManager:uruchomKomende(matches[2])
]]>
</script>
                        <command><![CDATA[^zi(.*)$]]></command>
                    </Alias>
                </AliasGroup>
            </AliasPackage>
        </ScriptGroup>
    </ScriptPackage>
</MudletPackage>
